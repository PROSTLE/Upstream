# Copy to .env and fill in. Nothing in Upstream falls back to mock data:
# a missing credential disables that feature and the dashboard tells you which one.

# ---------- Server ----------
PORT=8787
# Public URL PayPal and GitHub redirect back to (Render URL, or an https tunnel when local).
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_PATH=./data/upstream.db
# Required for every state-changing dashboard action (settle, approve, cancel). Generate a long random string.
ADMIN_TOKEN=
# Shared secret the Claude Code hook sends with each event. Generate a long random string.
INGEST_TOKEN=

# ---------- PayPal (developer.paypal.com > Apps & Credentials, Sandbox) ----------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled by `npm run setup:paypal` (stored in the DB); set here only to override.
PAYPAL_WEBHOOK_ID=
# Optional Payouts `purpose` (one of PayPal's purpose_enum values, e.g. DONATIONS). Leave empty to omit.
PAYOUT_PURPOSE=
PAYOUT_EMAIL_SUBJECT=You received an Upstream payout for your open-source work

# ---------- Funding plan ("agent tithe") ----------
TITHE_AMOUNT=10.00
TITHE_CURRENCY=USD
TITHE_INTERVAL_UNIT=MONTH
TITHE_PRODUCT_NAME=Upstream agent tithe
BRAND_NAME=Upstream

# ---------- Policy (enforced in code, never by the LLM) ----------
# Max share of one session's budget any single package can receive.
POLICY_MAX_PACKAGE_SHARE=0.4
# Smallest payout item sent; smaller allocations carry over for that maintainer.
POLICY_MIN_PAYOUT=1.00
# Largest single payout item.
POLICY_MAX_PAYOUT=250.00
# Fraction of each allocation reserved for PayPal's payout fee estimate. Actual fees are read back from PayPal.
POLICY_PAYOUT_FEE_RESERVE=0.02
# Allocations for repos with no verified maintainer are held this many days, then released to the pool.
POLICY_RESERVE_DAYS=60
# UNCLAIMED payout items older than this are cancelled (PayPal otherwise returns them after 30 days).
POLICY_CANCEL_UNCLAIMED_AFTER_DAYS=7

# ---------- AI attribution (Claude) ----------
ANTHROPIC_API_KEY=
UPSTREAM_MODEL=claude-opus-5-5
UPSTREAM_EFFORT=medium

# ---------- Maintainer claims (GitHub OAuth app; callback = PUBLIC_BASE_URL/api/claims/github/callback) ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional token for higher GitHub API rate limits when reading FUNDING.yml.
GITHUB_TOKEN=

# ---------- Package metadata ----------
DEPSDEV_API_BASE=https://api.deps.dev/v3
ECOSYSTEMS_API_BASE=https://packages.ecosyste.ms/api/v1
METADATA_CACHE_HOURS=24
