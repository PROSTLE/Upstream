# Copy to .env and fill in. Nothing in Upstream falls back to mock data:
# a missing credential disables that feature and the dashboard tells you which one.

# ---------- Server ----------
PORT=8787
# Public URL PayPal and GitHub redirect back to (Render URL, or an https tunnel when local).
PUBLIC_BASE_URL=http://localhost:8787
DATABASE_PATH=./data/upstream.db
# Required for every state-changing dashboard action (settle, approve, cancel), and to read a private dashboard. Generate a long random string.
ADMIN_TOKEN=
# Shared secret the Claude Code hook sends with each event; the agent's MCP tools also use it to read session evidence back.
INGEST_TOKEN=
# private (default): sessions, evidence, payouts and the ledger need ADMIN_TOKEN to read.
# public: anyone can read them (for a demo). Raw hook payloads, which contain your own code, always need ADMIN_TOKEN.
# Maintainer pages (/claim, /r/owner/name, the badge) are public either way.
DASHBOARD_ACCESS=private

# ---------- PayPal (developer.paypal.com > Apps & Credentials, Sandbox) ----------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled by `npm run setup:paypal` (stored in the DB); set here only to override.
PAYPAL_WEBHOOK_ID=
# Optional Payouts `purpose` (one of PayPal's purpose_enum values, e.g. DONATIONS). Leave empty to omit.
PAYOUT_PURPOSE=
PAYOUT_EMAIL_SUBJECT=You received an Upstream payout for your open-source work

# ---------- Funding plan ("agent tithe") ----------
TITHE_AMOUNT=10.00
TITHE_CURRENCY=USD
TITHE_INTERVAL_UNIT=MONTH
TITHE_PRODUCT_NAME=Upstream agent tithe
BRAND_NAME=Upstream
# Where this project's code lives, for the source links and the hook install command.
SOURCE_REPO_URL=https://github.com/PROSTLE/Upstream

# ---------- Policy (enforced in code, never by the LLM) ----------
# Max share of one session's budget any single package can receive.
POLICY_MAX_PACKAGE_SHARE=0.4
# Smallest payout item sent; smaller allocations carry over for that maintainer.
POLICY_MIN_PAYOUT=1.00
# Largest single payout item.
POLICY_MAX_PAYOUT=250.00
# Fraction of each allocation reserved for PayPal's payout fee estimate. Actual fees are read back from PayPal.
POLICY_PAYOUT_FEE_RESERVE=0.02
# Allocations for repos with no verified maintainer are held this many days, then released to the pool.
POLICY_RESERVE_DAYS=60
# UNCLAIMED payout items older than this are cancelled (PayPal otherwise returns them after 30 days).
POLICY_CANCEL_UNCLAIMED_AFTER_DAYS=7
# Optional: largest one-time top-up (PayPal Orders) from the dashboard. Empty = no Upstream cap; PayPal's limits apply.
POLICY_MAX_TOPUP=
# Optional: most a coding agent may request in top-ups per 24 hours through the MCP tool. Empty = agents can't request top-ups.
# The agent only gets a PayPal approval link; you still approve every payment on PayPal's own page.
POLICY_MAX_AGENT_TOPUP=

# ---------- AI attribution (Meta Muse Spark; key from dev.meta.ai > API keys) ----------
MODEL_API_KEY=
# The server pays for AI reviews, so each person other than the operator gets this many per 24 hours.
POLICY_MAX_REVIEWS_PER_DAY=20
MODEL_API_BASE=https://api.meta.ai
# Keep a Standard model: Meta may train on content sent to the -contributor models, and sessions contain your code.
UPSTREAM_MODEL=muse-spark-1.3
UPSTREAM_EFFORT=medium

# ---------- Maintainer claims (GitHub OAuth app; callback = PUBLIC_BASE_URL/api/claims/github/callback) ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional token for higher GitHub API rate limits when reading FUNDING.yml.
GITHUB_TOKEN=
# Anyone can sign in with GitHub and gets a private space. These logins (comma-separated) also own the server's original data and its server-wide tasks.
# The OAuth app also needs the callback PUBLIC_BASE_URL/api/auth/github/callback.
OPERATOR_GITHUB_LOGINS=
# Set to true after enabling "Log in with PayPal" for the app (Apps & Credentials > your app > Other features).
# Advanced settings: Return URL = PUBLIC_BASE_URL/api/claims/paypal/callback; user information: Email and Account verification status.
PAYPAL_LOGIN_ENABLED=

# ---------- Package metadata ----------
DEPSDEV_API_BASE=https://api.deps.dev/v3
ECOSYSTEMS_API_BASE=https://packages.ecosyste.ms/api/v1
METADATA_CACHE_HOURS=24
